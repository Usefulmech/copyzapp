# ── CopyZapp Environment Variables ────────────────────────────────────────────
# Copy this file to .env or .env.local for development and deployment.
# On Vercel, set variables in Vercel Dashboard → Settings → Environment Variables.

# ── Server ────────────────────────────────────────────────────────────────────
# Port for local dev server (default: 3000)
PORT=3000

# ── App URL (REQUIRED for Vercel deployment) ──────────────────────────────────
# The public URL where the app is deployed.
# Used to build QR-code share URLs that the phone can reach from anywhere.
# Example: https://copyzapp.vercel.app
APP_URL=

# ── Neon DB / PostgreSQL (RECOMMENDED for Persistent Serverless DB) ───────────
# Connection string for Neon DB (PostgreSQL).
# Example: postgresql://username:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ── Vercel KV (Redis) — optional alternative storage backend ────────────────
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Vercel Blob — optional cloud file storage ────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── Google Gemini AI (optional) ───────────────────────────────────────────────
GEMINI_API_KEY=

