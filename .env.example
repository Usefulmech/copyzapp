# ── CopyZap Environment Variables ────────────────────────────────────────────
# Copy this file to .env.local for local development.
# On Vercel, set all variables in the Vercel Dashboard → Settings → Environment Variables.

# ── Server ────────────────────────────────────────────────────────────────────
# Port for local dev server (default: 3000)
PORT=3000

# ── App URL (REQUIRED for Vercel deployment) ──────────────────────────────────
# The public URL where the app is deployed.
# Used to build QR-code share URLs that the phone can reach from anywhere.
# Leave blank for pure local-network (WiFi/Hotspot) use.
# Example: https://copyzap.vercel.app
APP_URL=

# ── Vercel KV (Redis) — required when VERCEL=1 ───────────────────────────────
# Auto-populated when you link a KV store in the Vercel Dashboard.
# Run `vercel env pull .env.local` to get these automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Vercel Blob — required when VERCEL=1 ─────────────────────────────────────
# Auto-populated when you link a Blob store in the Vercel Dashboard.
BLOB_READ_WRITE_TOKEN=

# ── Google Gemini AI (optional) ───────────────────────────────────────────────
# Only needed if you enable AI-powered features (smart tagging, summaries).
GEMINI_API_KEY=
